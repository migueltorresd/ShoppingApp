<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_blue"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Productos Disponibles"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_white" />

        <Button
            android:id="@+id/btnUbicacion"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:text="📍"
            android:textColor="@color/primary_blue"
            android:background="@color/background_white"
            android:textSize="16sp"
            style="?android:attr/borderlessButtonStyle" />

        <Button
            android:id="@+id/btnCerrarSesion"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:text="Logout"
            android:textColor="@color/background_white"
            android:background="@color/accent_orange"
            android:textSize="12sp"
            style="?android:attr/borderlessButtonStyle" />

        <Button
            android:id="@+id/btnVerCarrito"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Ver Carrito"
            android:textColor="@color/primary_blue"
            android:background="@color/background_white"
            android:textSize="12sp"
            style="?android:attr/borderlessButtonStyle" />

    </LinearLayout>

    <!-- Lista de Productos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvProductos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp" />

    <!-- Footer con información -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background_card"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Desliza para ver más productos"
            android:textSize="14sp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/tvItemsCarrito"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Items en carrito: 0"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/teal_accent" />

    </LinearLayout>

</LinearLayout>