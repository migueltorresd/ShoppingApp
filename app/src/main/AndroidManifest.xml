<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/ic_menu_gallery"
        android:label="Shopping App"
        android:theme="@style/Theme.ShoppingApp"
        tools:targetApi="31">

        <!-- LoginActivity - Activity principal y de entrada -->
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- RegistroActivity - Para registro de nuevos usuarios -->
        <activity
            android:name=".RegistroActivity"
            android:exported="false"
            android:parentActivityName=".LoginActivity" />

        <!-- ListadoProductosActivity - Pantalla principal de productos -->
        <activity
            android:name=".ListadoProductosActivity"
            android:exported="false" />

        <!-- CarritoActivity - Pantalla del carrito de compras -->
        <activity
            android:name=".CarritoActivity"
            android:exported="false"
            android:parentActivityName=".ListadoProductosActivity" />

    </application>

</manifest>